# Backend API URL for Frontend (Required when frontend and backend are separate)
# For Vercel frontend + Railway backend, set this to your Railway backend URL
# Leave empty if running frontend and backend together (like on Replit)
# VITE_API_URL=https://your-railway-backend-url.railway.app

# CORS Configuration (CRITICAL for Vercel + Railway deployment)
# Set this on Railway to allow requests from your Vercel frontend
# For multiple origins, separate with commas
# CORS_ORIGIN=https://your-vercel-app.vercel.app,https://your-custom-domain.com

# Authentication Control
# Set to "true" to disable authentication during development
# Remove or set to "false" to enable Google OAuth authentication
AUTH_DISABLED=true

# Google OAuth (Only needed when AUTH_DISABLED is false)
# Get these from: https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=your-client-id-here
# GOOGLE_CLIENT_SECRET=your-client-secret-here

# Session Secret (Always required)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-session-secret-here

# OpenAI API Key (Optional - for future AI features)
# Get this from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# Firebase Configuration (Optional - for Firebase Auth and App Check)
# Get these from: https://console.firebase.google.com/
# VITE_FIREBASE_API_KEY=your-api-key-here
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# VITE_FIREBASE_APP_ID=your-app-id

# reCAPTCHA Enterprise Site Key (Optional - for Firebase App Check)
# Get this from: https://console.cloud.google.com/security/recaptcha
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here

# Database (Automatically provided by Replit)
# DATABASE_URL=postgresql://...

# --- Additional required vars (fill these for local development) ---
# General
# NODE_ENV=development
# PORT=5000

# Backend / Database
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Session & JWT
# SESSION_SECRET=your-random-session-secret-here
# JWT_SECRET=your-jwt-secret-here

# Authentication
# AUTH_DISABLED=true
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:5000

# Google OAuth (if AUTH_DISABLED=false)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Railway / Hosting helpers
# RAILWAY_PUBLIC_DOMAIN=your-project.up.railway.app

# Replit dev helpers (only if running on Replit)
# REPL_ID=your-repl-id
# REPLIT_DEV_DOMAIN=your-repl-dev-domain.repl.co
# REPLIT_DOMAINS=your-production-domain.com,another-domain.com

# Vite (frontend) - exposed to client prefixed with VITE_
# VITE_API_URL=http://localhost:5000
# VITE_FIREBASE_WEB_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_RECAPTCHA_SITE_KEY=
# VITE_ADMOB_BANNER_ID=ca-app-pub-xxx/yyy
# VITE_ADMOB_REWARDED_ID=ca-app-pub-xxx/zzz

# Cloud storage (R2 / S3-like)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=your-bucket-name
# R2_PUBLIC_URL=https://your-r2-public-url

# 100ms / HMS keys (optional)
# HMS_APP_ACCESS_KEY=
# HMS_APP_SECRET=
# HMS_TEMPLATE_ID=

# Firebase Admin (server-side)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# FIREBASE_CLIENT_EMAIL=

# Push notifications
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional
# OPENAI_API_KEY=

# --- How to run locally ---
# 1. Copy this file to `.env` at the repository root and fill values.
# 2. Install dependencies: `npm install`
# 3. Run the development server (this runs the backend and Vite dev middleware):
#
# ```powershell
# npm run dev
# ```
#
# 4. Open the app in the browser at `http://localhost:5173` (or the address logged by the dev server).
#
# Notes for OAuth / external callbacks:
# - If you need a public callback URL (e.g., for Google OAuth) use a tunnel such as `ngrok` or configure your provider with your Railway/Vercel URL.
# - For local OAuth testing with `ngrok`: run `ngrok http 5000` and set `BACKEND_URL`/`VITE_API_URL` to `https://<ngrok-id>.ngrok.io` and update the OAuth redirect URIs in Google Cloud Console accordingly.
